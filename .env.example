# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=AI-Wealth-System
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=true
LOG_LEVEL=INFO

# ─── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─── AI APIs ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Primary LLM provider: openai | anthropic | local
PRIMARY_LLM_PROVIDER=anthropic

# Local LLM (Ollama)
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_wealth
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CELERY_BROKER=redis://localhost:6379/1
REDIS_CELERY_BACKEND=redis://localhost:6379/2

# ─── Vector Store ─────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=ai_wealth

# ─── Search APIs ──────────────────────────────────────────────────────────────
SERPER_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Fallback: DuckDuckGo (no API key needed)
DEFAULT_SEARCH_PROVIDER=duckduckgo

# ─── System Behaviour ─────────────────────────────────────────────────────────
RESEARCH_LOOP_INTERVAL_MINUTES=30
CEO_REVIEW_INTERVAL_MINUTES=60
MAX_CONCURRENT_AGENTS=10
OPPORTUNITY_SCORE_THRESHOLD=65
MAX_EXECUTION_BUDGET_USD=50.0

# ─── Memory ───────────────────────────────────────────────────────────────────
SHORT_TERM_TTL_SECONDS=3600
LONG_TERM_RETENTION_DAYS=365
MAX_VECTOR_RESULTS=10
