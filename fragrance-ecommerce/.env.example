# ==============================================================================
# SCENTARA — Environment Configuration
# Copy this file to .env and fill in all values
# ==============================================================================

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------
APP_NAME=Scentara
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-me-to-a-random-64-char-hex-string
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://scentara.com

# ------------------------------------------------------------------------------
# Database (PostgreSQL 15)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scentara
POSTGRES_USER=scentara_user
POSTGRES_PASSWORD=your-secure-postgres-password
DATABASE_URL=postgresql+asyncpg://scentara_user:your-secure-postgres-password@postgres:5432/scentara
DATABASE_POOL_SIZE=10

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_URL=redis://:your-secure-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:your-secure-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:your-secure-redis-password@redis:6379/2

# Flower monitor
FLOWER_USER=admin
FLOWER_PASSWORD=your-flower-password
FLOWER_PORT=5555

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-another-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Cloudflare R2 Storage
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=scentara-media
R2_PUBLIC_URL=https://cdn.scentara.com

# ------------------------------------------------------------------------------
# Anthropic AI
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key
AI_MODEL=claude-opus-4-8

# ------------------------------------------------------------------------------
# Stripe
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ------------------------------------------------------------------------------
# Etsy API
# ------------------------------------------------------------------------------
ETSY_API_KEY=your-etsy-api-key
ETSY_ACCESS_TOKEN=your-etsy-oauth-access-token
ETSY_SHOP_ID=your-etsy-shop-id

# ------------------------------------------------------------------------------
# eBay API
# ------------------------------------------------------------------------------
EBAY_APP_ID=your-ebay-app-id
EBAY_USER_TOKEN=your-ebay-user-token
EBAY_SANDBOX=true

# ------------------------------------------------------------------------------
# Facebook / Meta
# ------------------------------------------------------------------------------
FACEBOOK_ACCESS_TOKEN=your-facebook-page-access-token
FACEBOOK_PAGE_ID=your-facebook-page-id

# ------------------------------------------------------------------------------
# SMTP Email
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your-sendgrid-api-key
EMAILS_FROM_EMAIL=hello@scentara.com

# ------------------------------------------------------------------------------
# Sentry Monitoring
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
ENABLE_AI_LISTINGS=true
ENABLE_AUTO_PRICING=true
ENABLE_MARKETPLACE_SYNC=true
