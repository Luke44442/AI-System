// Multi-tenant SaaS schema for GrowthIQ
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── NextAuth required models ───────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  subscription     Subscription?
  workspaces       Workspace[]
  usageLogs        UsageLog[]
  researchRuns     ResearchRun[]
  ecommerceCycles  EcommerceCycle[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── SaaS core models ───────────────────────────────────────────────────────

model Workspace {
  id        String    @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  niche       String?
  description String?
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  researchRuns  ResearchRun[]
  opportunities SavedOpportunity[]
  contentItems  ContentItem[]

  @@index([workspaceId])
}

model ResearchRun {
  id        String   @id @default(cuid())
  topic     String
  results   Json
  userId    String
  projectId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model SavedOpportunity {
  id                String   @id @default(cuid())
  projectId         String
  title             String
  description       String   @db.Text
  niche             String
  platforms         String[]
  overallScore      Float
  viralityScore     Float
  monetizationScore Float
  competitionScore  Float
  easeScore         Float
  contentAngle      String?
  whyNow            String?  @db.Text
  keywords          String[]
  source            String?
  createdAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ContentItem {
  id        String   @id @default(cuid())
  projectId String
  type      String   // tiktok_script | youtube_idea | instagram_caption | ad_copy | landing_page
  platform  String
  title     String
  content   String   @db.Text
  prompt    String?  @db.Text
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
}

// ── Billing ────────────────────────────────────────────────────────────────

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  tier                 String    @default("free")   // free | pro | creator_pro | agency
  status               String    @default("active") // active | canceled | past_due | trialing
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // research_run | content_gen | opportunity_save | ecommerce_cycle
  date      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ── E-commerce OS ──────────────────────────────────────────────────────────

model EcommerceCycle {
  id             String   @id @default(cuid())
  userId         String
  status         String   @default("running") // running | complete | error
  focusNiche     String?
  errorMessage   String?
  approvalStatus String   @default("pending") // pending | approved | rejected

  opportunities  ProductOpportunity[]
  storeBlueprint StoreBlueprint?
  marketingPlan  MarketingPlan?
  approvalItems  ApprovalItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ProductOpportunity {
  id                 String   @id @default(cuid())
  cycleId            String
  rank               Int      @default(0)
  name               String
  description        String   @db.Text
  category           String
  productType        String   // digital | pod | service | physical
  demandScore        Int
  competitionLevel   String   // low | medium | high
  competitionScore   Int
  monetizationScore  Int
  overallScore       Float
  platforms          String[]
  targetBuyer        String
  priceRange         String
  whyNow             String   @db.Text
  validationDecision String?  // launch | test | reject
  validationReason   String?  @db.Text
  suggestedPrice     String?
  differentiators    String[]
  isTopPick          Boolean  @default(false)

  cycle     EcommerceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  listings  ProductListing[]

  createdAt DateTime @default(now())

  @@index([cycleId, overallScore])
}

model StoreBlueprint {
  id             String   @id @default(cuid())
  cycleId        String   @unique
  storeName      String
  storeNameAlts  String[]
  tagline        String
  brandColors    String[]
  brandTone      String
  niche          String
  positioning    String   @db.Text
  productCatalog Json
  launchChecklist Json
  createdAt      DateTime @default(now())

  cycle EcommerceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
}

model ProductListing {
  id             String   @id @default(cuid())
  opportunityId  String
  productName    String
  title          String
  description    String   @db.Text
  tags           String[]
  keywords       String[]
  price          String
  bundleIdeas    String[]
  seoNotes       String[]
  designPrompts  String[]
  fileSpecs      Json?
  createdAt      DateTime @default(now())

  opportunity ProductOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

model MarketingPlan {
  id              String   @id @default(cuid())
  cycleId         String   @unique
  tiktokIdeas     Json
  instagramIdeas  Json
  hookScripts     Json
  postingSchedule Json
  launchStrategy  String   @db.Text
  createdAt       DateTime @default(now())

  cycle EcommerceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
}

model ApprovalItem {
  id          String    @id @default(cuid())
  cycleId     String
  step        String    // setup_store | create_listing | publish | run_ads
  title       String
  description String    @db.Text
  riskLevel   String    @default("low") // low | medium | high
  instructions String   @db.Text
  status      String    @default("pending") // pending | approved | rejected
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())

  cycle EcommerceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, status])
}
